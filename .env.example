# Copy to .env.local and fill in. Never commit .env.local.

# Public address of the site (canonical links, sitemap). Defaults to the live Vercel site if empty.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Every link inside emails points here, even when testing locally. Defaults to https://glance-of-gold.vercel.app
EMAIL_SITE_URL=https://glance-of-gold.vercel.app

# Supabase (project: gold of glance)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Admin account created by scripts/create-admin.ts
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Order emails (Nodemailer). Default: Gmail with an app password.
SMTP_USER=
SMTP_APP_PASSWORD=
ORDER_NOTIFY_EMAIL=
# Optional, for best inbox delivery: a mail provider and a domain you own (SPF + DKIM + DMARC).
# Leave SMTP_HOST empty to keep using Gmail.
SMTP_HOST=
SMTP_PORT=465
MAIL_FROM_EMAIL=

# WhatsApp number in international format without "+", e.g. 923001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Meta Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
