# Copy to .env.local and fill in. Never commit .env.local.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (project: gold of glance)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Admin account created by scripts/create-admin.ts
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Order emails (Nodemailer, Gmail app password)
SMTP_USER=
SMTP_APP_PASSWORD=
ORDER_NOTIFY_EMAIL=

# WhatsApp number in international format without "+", e.g. 923001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Meta Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
